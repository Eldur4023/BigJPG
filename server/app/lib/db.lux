# Esquema, migraciones y consultas de uso común.
#
# Las marcas de tiempo son INTEGER en milisegundos UTC. Los ids de trabajo son aleatorios (hex).
#
# MIGRACIONES. `migrations()` es una lista de versiones: la posición N lista las sentencias que llevan el
# esquema de la versión N a la N+1. Al arrancar se aplican, en orden, las que superan a `schema_version`.
# Para cambiar el esquema se AÑADE una versión al final; nunca se edita una anterior.

fn List<Json> migrations():
    return [
        [
            """
            create table jobs (
                id text primary key,
                name text not null,
                model text not null,
                scale integer not null,
                fmt text not null,
                status text not null default 'queued',      -- queued | running | done | error | canceled
                progress real not null default 0,           -- 0..100
                error text not null default '',
                in_path text not null,
                out_path text not null default '',
                in_bytes integer not null default 0,
                out_bytes integer not null default 0,
                in_w integer not null default 0,
                in_h integer not null default 0,
                out_w integer not null default 0,
                out_h integer not null default 0,
                created_at integer not null,
                started_at integer,
                finished_at integer
            )
            """,
            "create index ix_jobs_status on jobs (status, created_at)",
            "create index ix_jobs_created on jobs (created_at)",
            "create table meta (key text primary key, value text not null)"
        ]
    ]

on start:
    await sqlite.exec("create table if not exists schema_version (version integer not null)")
    List<Json> v = await sqlite.query("select version from schema_version")
    int current = 0
    if len(v) == 0:
        await sqlite.exec("insert into schema_version (version) values (0)")
    else:
        current = v[0]["version"]
    List<Json> all = migrations()
    while current < len(all):
        await sqlite.begin()
        for string ddl in all[current]:
            await sqlite.exec(ddl)
        current = current + 1
        await sqlite.exec("update schema_version set version = ?", current)
        await sqlite.commit()
        log.info("esquema migrado a la versión " + str(current))
    # Un reinicio a mitad de un trabajo lo deja «running» para siempre: se vuelve a encolar.
    int n = await sqlite.exec("update jobs set status = 'queued', progress = 0, started_at = null where status = 'running'")
    if n > 0:
        log.warn(str(n) + " trabajo(s) interrumpido(s) por un reinicio: vuelven a la cola")
    log.info("BigJPG listo (esquema v" + str(current) + ")")

fn Json first(List<Json> rows):
    return len(rows) == 0 ? null : rows[0]

fn string new_id():
    return hash.random_hex(12)

fn string meta_get(string key, string fallback):
    Json r = first(await sqlite.query("select value from meta where key = ?", key))
    return r == null ? fallback : str(r["value"])

fn bool meta_set(string key, string value):
    await sqlite.exec("insert into meta (key, value) values (?, ?) on conflict(key) do update set value = excluded.value", key, value)
    return true
