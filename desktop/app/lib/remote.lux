# El servidor de BigJPG (la misma API que sirve la web), por Tailscale.
#
# Las subidas y la descarga del resultado van con curl: el cliente http de Lux no sabe hacer multipart ni
# guardar un binario a disco, y curl está en todas partes.

fn string server_url():
    return await meta_get("server_url", "")

fn Json csrf():
    return { "X-Requested-With": "bigjpg" }

# {"ok", "ready", "device", "error"}, con una caché de 15 s: la interfaz pregunta cada pocos segundos y no
# hay por qué esperar al servidor en cada pregunta.
fn Json remote_state(bool fresh):
    string url = await server_url()
    if url == "":
        return { "ok": false, "configured": false, "ready": false, "device": "", "error": "sin configurar", "convert": null, "inpaint": false }
    Json cached = state.get("remote_state", null)
    if not fresh and cached != null and time.now() - cached["at"] < 15000 and cached["url"] == url:
        return cached["value"]
    Json value = null
    try:
        Json r = await http.get(url + "/api/info", {}, { "timeout_ms": 4000 })
        if r["status"] == 200 and r["body"] != null and r["body"]["mode"] == "server":
            value = { "ok": true, "configured": true, "ready": r["body"]["engine"]["ready"] == true, "device": str(r["body"]["engine"]["device"]), "error": r["body"]["engine"]["ready"] == true ? "" : "el servidor no tiene el motor instalado", "convert": r["body"]["convert"], "inpaint": r["body"]["inpaint"] == true }
        else:
            value = { "ok": false, "configured": true, "ready": false, "device": "", "convert": null, "inpaint": false, "error": "eso no parece un servidor de BigJPG (respondió " + str(r["status"]) + ")" }
    catch e:
        value = { "ok": false, "configured": true, "ready": false, "device": "", "convert": null, "inpaint": false, "error": "no responde: " + e.message }
    state.set("remote_state", { "at": time.now(), "url": url, "value": value })
    return value

# Como os.run, pero sin su tope de 2 minutos (proc.wait espera de 30 s en 30 s): subir o bajar un vídeo tarda más.
fn Json run_long(string bin, List<string> args, int seconds):
    string out_file = os.temp_file()
    int h = proc.start(bin, args, { "stdout": out_file, "stderr": "null" })
    Json code = null
    long deadline = time.now() + seconds * 1000
    while code == null and time.now() < deadline:
        code = await proc.wait(h, 30000)
    if code == null:
        proc.kill(h)
        await proc.wait(h, 3000)
    proc.close(h)
    string out = os.is_file(out_file) ? await os.read_file(out_file) : ""
    if os.is_file(out_file):
        os.remove_file(out_file)
    return { "status": code == null ? -1 : code, "stdout": out, "stderr": code == null ? "se agotó el tiempo" : "" }

# Sube un trabajo al servidor. Devuelve {"ok", "remote_id", "error"}.
fn Json remote_upload(Json job):
    string url = await server_url()
    # El nombre que viaja en el multipart: sin comillas, punto y coma ni nada raro.
    string safe = regex.replace("[^A-Za-z0-9._ -]", job["name"], "_")
    # Un vídeo pesa: se le da más tiempo que a una imagen.
    bool video = (job["kind"] == "inpaint" and job["fmt"] == "mp4") or job["kind"] == "chain"
    List<string> args = ["-s", "-m", video ? "900" : "110", "-w", "\n%{http_code}", "-H", "X-Requested-With: bigjpg"]
    string api_path = ""
    if job["kind"] == "chain":
        # Un archivo + los pasos (--form-string: el JSON lleva comillas) + la máscara si hay quitar marca.
        string mask = os.path_join(os.path_dirname(job["in_path"]), "mask.png")
        List<Json> wanted = json.parse(job["opts"])["steps"]
        bool marks = false
        for Json w in wanted:
            if w["op"] == "inpaint":
                marks = true
        args.add("-F")
        args.add("file=@" + job["in_path"] + ";filename=" + safe)
        args.add("--form-string")
        args.add("steps=" + json.stringify(wanted))
        if marks and os.is_file(mask):
            args.add("-F")
            args.add("masks=@" + mask + ";filename=mask.png")
        api_path = "/api/chain"
    else if job["kind"] == "pdf":
        for string pg in pdf_pages(os.path_dirname(job["in_path"])):
            args.add("-F")
            args.add("files=@" + pg + ";filename=" + regex.replace("[^A-Za-z0-9._ -]", os.path_basename(pg), "_"))
        api_path = "/api/pdf"
    else:
        args.add("-F")
        args.add("file=@" + job["in_path"] + ";filename=" + safe)
        if job["kind"] == "inpaint":
            args.add("-F")
            args.add("mask=@" + os.path_join(os.path_dirname(job["in_path"]), "mask.png") + ";filename=mask.png")
            if job["fmt"] == "mp4":
                Json o = json.parse(job["opts"])
                api_path = "/api/inpaint/video?mode=" + str(o["mode"]) + "&tms=" + str(o["tms"])
            else:
                api_path = "/api/inpaint?fmt=" + job["fmt"]
        else if job["kind"] == "convert":
            api_path = "/api/convert?fmt=" + job["fmt"]
        else:
            api_path = "/api/jobs?model=" + job["model"] + "&scale=" + str(job["scale"]) + "&fmt=" + job["fmt"]
    args.add(url + api_path)
    Json r = await run_long("curl", args, video ? 910 : 118)
    string out = str(r["stdout"])
    List<string> lines = out.split("\n")
    if r["status"] != 0 or len(lines) < 2:
        return { "ok": false, "remote_id": "", "error": "no se pudo subir al servidor: " + str(r["stderr"]).trim() }
    string code = lines[len(lines) - 1]
    string body = out.slice(0, len(out) - len(code) - 1)
    Json parsed = null
    try:
        parsed = json.parse(body)
    catch e:
        parsed = null
    if code != "201" or parsed == null or parsed["id"] == null:
        string why = parsed != null and parsed["detail"] != null ? str(parsed["detail"]) : "el servidor respondió " + code
        return { "ok": false, "remote_id": "", "error": why }
    return { "ok": true, "remote_id": str(parsed["id"]), "error": "" }

# Trae el resultado ya terminado del servidor a `dest`.
fn bool remote_download(string remote_id, string dest):
    string url = await server_url()
    Json r = await run_long("curl", ["-sf", "-m", "900", "-o", dest, url + "/api/jobs/" + remote_id + "/result"], 910)
    return r["status"] == 0 and os.is_file(dest)

fn bool remote_delete(string remote_id):
    string url = await server_url()
    try:
        await http.delete(url + "/api/jobs/" + remote_id, csrf(), { "timeout_ms": 4000 })
    catch e:
        return false
    return true

# Un trozo de cadena (pasos seguidos que van al servidor): se sube `cur`, se espera su trabajo allí (reflejando el
# progreso y la cancelación) y se trae el resultado a `out`.
fn Json run_remote_segment(Json job, string cur, List<Json> seg, string out, int at, int n):
    string url = await server_url()
    # El servidor decide por la extensión del nombre: el archivo de ahora no es el que se soltó.
    string name = regex.replace("\\.[^.]*$", job["name"], "") + "." + file_ext(cur)
    Json up = null
    try:
        up = await remote_upload({ "id": job["id"], "name": name, "kind": "chain", "fmt": "", "in_path": cur, "out_path": out, "opts": json.stringify({ "steps": seg }) })
    catch e:
        up = { "ok": false, "remote_id": "", "error": "no se pudo subir al servidor: " + e.message }
    if not up["ok"]:
        return { "ok": false, "error": str(up["error"]), "device": "" }
    string rid = up["remote_id"]
    int fails = 0
    long deadline = time.now() + 6 * 3600 * 1000
    while time.now() < deadline:
        Json mine = first(await sqlite.query("select status from jobs where id = ?", job["id"]))
        if mine == null or mine["status"] != "running":
            await remote_delete(rid)
            return { "ok": false, "error": "cancelado", "device": "" }
        Json r = null
        try:
            r = await http.get(url + "/api/jobs/" + rid, {}, { "timeout_ms": 5000 })
        catch e:
            r = null
        if r == null or r["status"] != 200:
            fails = fails + 1
            if fails > 40:
                return { "ok": false, "error": "se perdió la conexión con el servidor", "device": "" }
        else:
            fails = 0
            string st = str(r["body"]["status"])
            if st == "done":
                if not await remote_download(rid, out):
                    return { "ok": false, "error": "no se pudo traer el resultado del servidor", "device": "" }
                await remote_delete(rid)
                return { "ok": true, "error": "", "device": "" }
            if st == "error" or st == "canceled":
                return { "ok": false, "error": "el servidor: " + str(r["body"]["error"]), "device": "" }
            float p = r["body"]["progress"]
            await sqlite.exec("update jobs set progress = ? where id = ? and status = 'running'", (at + p / 100.0 * len(seg)) / n * 100.0, job["id"])
        await sleep(1000)
    return { "ok": false, "error": "el servidor tardó demasiado", "device": "" }

# El escritorio sí reparte los pasos con `on: "server"` (ver run_chain en lib/chain.lux).
fn bool delegates():
    return true
